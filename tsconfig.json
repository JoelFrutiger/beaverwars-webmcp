{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["webmcp-types"]
  },
  "include": ["src/**/*.ts", "demo/**/*.ts", "vite.config.ts", "vitest.config.ts"]
}

